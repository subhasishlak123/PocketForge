<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121318">

    <!-- Modern Header Bar -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PocketForge"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Theme Chooser -->
        <Button
            android:id="@+id/btnTheme"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#242630"
            android:text="Theme"
            android:textAllCaps="false"
            android:textColor="#D1D5DB"
            android:textSize="12sp" />

        <!-- Install Shortcut -->
        <Button
            android:id="@+id/btnInstallShortcut"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#242630"
            android:text="Install"
            android:textAllCaps="false"
            android:textColor="#D1D5DB"
            android:textSize="12sp" />

        <!-- Run / Stop Button -->
        <Button
            android:id="@+id/btnToggleView"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#6366F1"
            android:text="▶ Run"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sleek Code Editor -->
    <EditText
        android:id="@+id/codeEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarLayout"
        android:background="#1A1C23"
        android:gravity="top|start"
        android:hint="// Start typing your mini-app or game here..."
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="16dp"
        android:textColor="#F3F4F6"
        android:textColorHint="#6B7280"
        android:textSize="14sp"
        android:typeface="monospace" />

    <!-- Full-Screen Runner Canvas -->
    <WebView
        android:id="@+id/miniAppWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</RelativeLayout>
